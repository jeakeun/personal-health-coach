# ---------------------------------------------------------------------------
# Personal Health Coach — 설정 예시
#
# 이 파일을 %LOCALAPPDATA%\PersonalHealthCoach\config\.env 로 복사해 사용합니다.
#
# ⚠ 이 파일에는 자격증명이 없고, 앞으로도 두지 않습니다 (NFR-45).
#    경계 규칙: "복호화하면 데이터를 볼 수 있게 되는 값"은 Windows DPAPI 가 보관하고,
#              나머지(경로·튜닝값·기능 플래그)만 이 파일에 둡니다.
#    암호화 키는 애플리케이션이 최초 기동 시 DPAPI 에 생성하며,
#    이 파일이나 소스코드 어디에도 나타나지 않습니다.
# ---------------------------------------------------------------------------

# 실행 환경: dev | prod
# dev  — 사람이 읽는 로그 포맷, 민감값 유출 시 즉시 예외
# prod — JSON Lines 로그, 민감값은 대체 표기 후 경고
PHC_ENV=prod

# 루프백 바인딩 포트 (127.0.0.1 고정, 외부 인터페이스에 바인딩하지 않음)
PHC_PORT=8765

# ---------------------------------------------------------------------------
# 경로 — 비우면 %LOCALAPPDATA%\PersonalHealthCoach\ 기준 기본값을 사용합니다.
# ---------------------------------------------------------------------------
# PHC_DATA_DIR=

# ⚠ 백업 경로 권장 사항
#    기본값은 데이터와 같은 디스크입니다. 디스크 장애가 나면 원본과 백업이
#    함께 사라지므로 실질적인 방어가 되지 않습니다 (RSK-06).
#    외장 드라이브나 동기화 폴더 경로를 지정하시길 권합니다.
#    지정하지 않으면 운영 상태 화면에 상시 주의 표시가 뜹니다.
# PHC_BACKUP_DIR=

# ---------------------------------------------------------------------------
# 비밀번호 해시 (Argon2id)
#
# 성능 예산이 강도의 상한 역할을 합니다 (NFR-1A-05, 목표 <= 500ms).
#   실측 > 500ms  -> 강도 하향 (단 memory 32768 KiB 미만 금지)
#   실측 150~500ms -> 유지
#   실측 < 150ms  -> 강도 상향
# 값을 바꾸면 다음 로그인 성공 시 자동 재해시됩니다 (BR-PW-07).
# ---------------------------------------------------------------------------
PHC_ARGON2_MEMORY_KIB=65536
PHC_ARGON2_TIME_COST=3
PHC_ARGON2_PARALLELISM=4

# ---------------------------------------------------------------------------
# 세션 (F3=B)
# ---------------------------------------------------------------------------
PHC_SESSION_IDLE_MINUTES=60
PHC_SESSION_ABSOLUTE_DAYS=7

# ---------------------------------------------------------------------------
# 무차별 대입 방어 (F2=A)
# 실패 누적에 따른 지연: 0/1/2/4/8초, 임계 초과 시 잠금(자동 해제)
# ---------------------------------------------------------------------------
PHC_LOCKOUT_THRESHOLD=10
PHC_LOCKOUT_MINUTES=15
PHC_LOGIN_RATE_PER_MINUTE=10

# ---------------------------------------------------------------------------
# 작업 큐 (F8=A)
# ---------------------------------------------------------------------------
PHC_WORKER_THREADS=1
PHC_JOB_MAX_ATTEMPTS=3
PHC_JOB_HEARTBEAT_TIMEOUT_MINUTES=5

# ---------------------------------------------------------------------------
# 백업 (I3=A) — 세대 보관: 일 7 + 주 4 + 월 3
# ---------------------------------------------------------------------------
PHC_BACKUP_HOUR=3
PHC_BACKUP_KEEP_DAILY=7
PHC_BACKUP_KEEP_WEEKLY=4
PHC_BACKUP_KEEP_MONTHLY=3

# ---------------------------------------------------------------------------
# 감사·로그 보존 (F9=A, I7=A)
# ---------------------------------------------------------------------------
PHC_AUDIT_RETENTION_DAYS=365
PHC_LOG_RETENTION_DAYS=30
