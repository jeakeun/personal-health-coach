# ---------------------------------------------------------------------------
# 민감 데이터 — 이중 방어
#
# 런타임 데이터는 %LOCALAPPDATA%\PersonalHealthCoach\ 에 있으므로
# 이 저장소 안에는 원래 존재하지 않습니다 (Infrastructure Design I2=B).
# 아래 항목은 누군가 PHC_DATA_DIR 을 프로젝트 폴더로 설정하는 경우를 대비한
# 이중 방어입니다. 1차 방어는 "데이터가 저장소 밖에 있다"는 구조 자체입니다.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

data/
logs/
backups/
audit-archive/

*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.bak
*.bak.enc

# 유출 비밀번호 목록 원본 (대용량, 번들 산출물만 커밋)
scripts/_downloads/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# ---------------------------------------------------------------------------
# 도구 캐시
# ---------------------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.import_linter_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml
sbom.json
requirements-audit.txt

# ---------------------------------------------------------------------------
# 편집기 / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini
